{
  "name": "@trustnxt/c2pa-ts",
  "version": "0.14.1",
  "type": "module",
  "author": "TrustNXT GmbH <mail@trustnxt.com>",
  "license": "Apache-2.0",
  "description": "Pure TypeScript implementation of C2PA manifest reading, validation, and creation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrustNXT/c2pa-ts.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./asset": {
      "types": "./dist/asset/index.d.ts",
      "import": "./dist/asset/index.js"
    },
    "./cose": {
      "types": "./dist/cose/index.d.ts",
      "import": "./dist/cose/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./jumbf": {
      "types": "./dist/jumbf/index.d.ts",
      "import": "./dist/jumbf/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "import": "./dist/manifest/index.js"
    },
    "./rfc3161": {
      "types": "./dist/rfc3161/index.d.ts",
      "import": "./dist/rfc3161/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "core-js": "^3.50.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@peculiar/x509": "^2.1.0",
    "cbor-x": "^1.6.6",
    "crc-32": "^1.2.2",
    "pkijs": "^3.4.1",
    "schema-dts": "^2.1.0",
    "typed-binary": "^4.3.3",
    "uuid": "^14.0.2"
  },
  "scripts": {
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "test": "bun test",
    "build": "tsup",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && bunx npm@latest exec changeset -- publish"
  }
}
